SSHW_PORT=8080
SSHW_ADMIN_USERNAME=admin
SSHW_ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -base64 32
SSHW_MASTER_KEY=replace-with-a-random-32-byte-base64-key
SSHW_DEFAULT_PROFILE=default
TZ=Asia/Shanghai
# Optional when the default Go module proxy is unavailable during image builds.
# GOPROXY=https://goproxy.cn,direct
