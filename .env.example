# Optional. All values have usable defaults, so this file is not required.
SSHW_PORT=9110
SSHW_BIND_ADDRESS=0.0.0.0
SSHW_ADMIN_USERNAME=admin
# Leave these unset to generate and persist secure random values automatically.
# SSHW_ADMIN_PASSWORD=replace-with-a-strong-password
# SSHW_MASTER_KEY=replace-with-a-random-32-byte-base64-key
SSHW_DEFAULT_PROFILE=default
TZ=Asia/Shanghai
# Optional volume name for backups or multiple instances.
# SSHW_DATA_VOLUME=sshw-config-data
# Optional when the default Go module proxy is unavailable during image builds.
# GOPROXY=https://goproxy.cn,direct
